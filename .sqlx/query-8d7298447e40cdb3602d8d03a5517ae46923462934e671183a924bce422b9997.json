  "query": "\n\t\t\tSELECT guild_id, waifu_channel, dead_chat_channel\n\t\t\tFROM guild_settings\n\t\t\tWHERE (\n    \t\t\twaifu_channel IS NOT NULL\n    \t\t\tAND $1 - last_waifu >= waifu_rate\n\t\t\t)\n\t\t\tOR (\n    \t\t\tdead_chat_channel IS NOT NULL\n    \t\t\tAND $1 - last_dead_chat >= dead_chat_rate\n\t\t\t)\n\t\t\t",
